[Unit]
Description=bgpcanary BGP visibility monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bgpcanary
Group=bgpcanary
WorkingDirectory=/opt/bgpcanary
Environment=BGPCANARY_CONFIG=/etc/bgpcanary/config.toml
ExecStart=/opt/bgpcanary/venv/bin/uvicorn bgpcanary.web:app --host 127.0.0.1 --port 8080 --workers 1 --proxy-headers --forwarded-allow-ips 127.0.0.1 --no-access-log
Restart=always
RestartSec=5
# sandbox: the service only needs its data directory, outbound network and its own files
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ReadWritePaths=/var/lib/bgpcanary
UMask=0027
CapabilityBoundingSet=
AmbientCapabilities=
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

[Install]
WantedBy=multi-user.target
