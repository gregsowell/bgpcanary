[Unit]
Description=bgpcanary BGP visibility monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bgpcanary
Group=bgpcanary
WorkingDirectory=/opt/bgpcanary
Environment=BGPCANARY_CONFIG=/etc/bgpcanary/config.toml
ExecStart=/opt/bgpcanary/venv/bin/uvicorn bgpcanary.web:app --host 127.0.0.1 --port 8080 --workers 1 --proxy-headers --forwarded-allow-ips 127.0.0.1 --no-access-log
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/bgpcanary

[Install]
WantedBy=multi-user.target
